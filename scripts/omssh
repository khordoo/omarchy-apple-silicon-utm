#!/bin/bash
# Atajo para entrar por SSH en la VM durante el desarrollo.
#   OM_HOST=192.168.64.20 OM_USER=builder ./scripts/omssh "comando"
# La IP se puede sacar con:  utmctl ip-address "Omarchy ARM"
: "${OM_USER:=builder}"
if [ -z "${OM_HOST:-}" ]; then
  if [ -f "${OMARCHY_CATALOG:-$(cd "$(dirname "$0")/.." && pwd)/localization/catalog.sh}" ]
  then . "${OMARCHY_CATALOG:-$(cd "$(dirname "$0")/.." && pwd)/localization/catalog.sh}"; fi
  omarchy_msg omssh_missing_host >&2
  exit 1
fi
exec ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null \
        -o LogLevel=ERROR -o ConnectTimeout=10 "$OM_USER@$OM_HOST" "$@"
