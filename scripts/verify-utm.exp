#!/usr/bin/expect -f
# Verifica la VM arrancada en UTM por su puerto serie (pty).
# Uso: verify-utm.exp /dev/ttysNNN     (utmctl attach imprime el pty)
set timeout 120
log_user 1
match_max 200000
set DEV [lindex $argv 0]

proc msg {key} {
    set lang "en"
    if {[info exists ::env(OMARCHY_LANG)] && $::env(OMARCHY_LANG) eq "es"} { set lang "es" }
    switch -- "$lang:$key" {
        en:usage { return "Usage: verify-utm.exp /dev/ttysNNN" }
        es:usage { return "Uso: verify-utm.exp /dev/ttysNNN" }
        en:no_login { return "login did not appear" }
        es:no_login { return "no aparece el login" }
        en:no_shell { return "shell did not appear" }
        es:no_shell { return "no hay shell" }
        en:verification { return "VERIFICATION" }
        es:verification { return "VERIFICACION" }
        en:system { return "system" }
        es:system { return "sistema" }
        en:storage { return "storage" }
        es:storage { return "almacenamiento" }
        en:services { return "services" }
        es:services { return "servicios" }
        en:failed { return "failed" }
        es:failed { return "fallidos" }
        en:packages { return "packages" }
        es:packages { return "paquetes" }
        en:theme { return "theme" }
        es:theme { return "tema" }
        en:network { return "network" }
        es:network { return "red" }
        en:session { return "graphical session" }
        es:session { return "sesion grafica" }
        en:gpu { return "GPU / virgl" }
        es:gpu { return "GPU / virgl" }
        en:boot_errors { return "boot errors" }
        es:boot_errors { return "errores del arranque" }
        en:end { return "END" }
        es:end { return "FIN" }
        default { return $key }
    }
}

if {$DEV eq ""} { puts [msg usage]; exit 1 }

set fd [open $DEV w+]
fconfigure $fd -mode 115200,n,8,1 -translation binary -buffering none
spawn -open $fd

proc go {cmd tok {t 90}} {
    global timeout
    set timeout $t
    send "$cmd; echo $tok\$?\r"
    expect {
        -re "$tok\[0-9\]+" {}
        timeout { send_user "\n*** TIMEOUT ***\n" }
    }
}

send "\r"
expect {
    -re {omarchy login:} {}
    timeout { puts "\n!! [msg no_login]"; exit 2 }
}
send "gabriel\r"
expect -re {[Pp]assword:}
send "gabriel\r"
expect {
    -re {\$ $|\$ } {}
    timeout { puts "\n!! [msg no_shell]"; exit 3 }
}
send "export PS1='V> ' TERM=dumb; stty cols 160; echo TOK_SH_\$?\r"
expect -re {TOK_SH_[0-9]+}

puts "\n\n============== [msg verification] =============="
go "echo; echo '### [msg system]'; uname -srm; grep PRETTY /etc/os-release" T1_
go "echo '### [msg storage]'; findmnt -no SOURCE,FSTYPE,OPTIONS / ; findmnt -no SOURCE,FSTYPE /home; findmnt -no SOURCE,FSTYPE /boot; df -h / | tail -1" T2_
go "echo '### [msg services]'; systemctl is-active sddm NetworkManager systemd-logind; echo '--- [msg failed]:'; systemctl --failed --no-pager --no-legend" T3_
go "echo '### [msg packages]'; pacman -Q hyprland waybar uwsm sddm mesa walker elephant xdg-terminal-exec 2>&1" T4_
go "echo '### dotfiles'; ls ~/.config | tr '\\n' ' '; echo; echo -n '[msg theme]: '; readlink -f ~/.config/omarchy/current/theme" T5
go "echo '### omarchy bin'; ls ~/.local/share/omarchy/bin | wc -l; command -v omarchy-theme-set omarchy-menu 2>&1" T6
go "echo '### [msg network]'; ip -4 -br addr show scope global; ping -c2 -W3 mirror.archlinuxarm.org 2>&1 | tail -2" T7
go "echo '### [msg session]'; loginctl list-sessions --no-legend; pgrep -a Hyprland | head -2; pgrep -a sddm | head -2" T8
go "echo '### [msg gpu]'; ls /dev/dri/ 2>&1; lspci 2>/dev/null | grep -i -E 'vga|display|gpu'; dmesg 2>/dev/null | grep -i -E 'virtio_gpu|drm' | tail -6" T9_
go "echo '### [msg boot_errors]'; journalctl -b -p err --no-pager 2>&1 | tail -25" TA_ 150
puts "\n============== [msg end] =============="
send "exit\r"
sleep 1
exit 0
